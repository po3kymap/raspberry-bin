# Settings for the Raspberry Bin client. On the Pi, copy to
# /etc/raspberry-bin.env and make it readable only by root:
#   sudo chmod 600 /etc/raspberry-bin.env
# Never commit the real file: it contains the device key.

RBIN_SERVER_URL=https://raspberrybin.app
RBIN_BIN_ID=bin-27

# Device API key (DEVICE_API_KEY in backend/.env on the server)
RBIN_DEVICE_KEY=

# Photo size; the model resizes to 224x224 anyway, smaller uploads are faster
RBIN_PHOTO_WIDTH=1024
RBIN_PHOTO_HEIGHT=768
# 0, 90, 180 or 270, depending on how the camera is mounted
RBIN_CAMERA_ROTATION=0

# How long a lid stays open after a sorted scan (FR3)
RBIN_LID_OPEN_SECONDS=5

# For testing without a camera: send this photo instead
#RBIN_TEST_PHOTO=/home/pi/test.jpg
